# Copy to .env on the server. Never commit the real file.
SECRET_KEY=replace-with-a-long-random-production-secret
# 仅数据库为空时创建一次。首次登录后应立即改密，并从 .env 删除密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
POSTGRES_DB=aipower
POSTGRES_USER=aipower
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://aipower:replace-with-a-strong-database-password@postgres:5432/aipower
# 服务器对外访问地址。内网部署时填内网 IP；公网部署时填公网 IP 或域名。
PUBLIC_URL=http://192.168.1.100:8080
# 必须与主站不同源。可使用同一主机的另一端口，或独立 tools 子域。
TOOL_PUBLIC_ORIGIN=http://192.168.1.100:8081
# 默认监听所有网卡，便于同一内网/公网访问；仅本机访问可改为 127.0.0.1。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
TOOL_BIND_ADDRESS=0.0.0.0
TOOL_PORT=8081
CORS_ORIGINS=http://192.168.1.100:8080
# 文件中心逻辑总容量和系统保留空间（字节）。按服务器磁盘调整。
FILE_STORAGE_QUOTA_BYTES=21474836480
FILE_STORAGE_MIN_FREE_BYTES=1073741824
# 审计日志在线保留天数（7-3650），更长期记录应输出到独立日志/审计系统。
AUDIT_LOG_RETENTION_DAYS=180
# 已配置 HTTPS 反向代理后改为 true；HTTP 内网环境设为 false。
SESSION_COOKIE_SECURE=false
